# Framing Invariance Lab v2.0. Never commit real tokens, keys, or certificates.

# Local mode preserves the loopback bearer-token workflow.
AUTH_MODE=local
HOST=127.0.0.1
PORT=8787
AUTH_TOKEN=
ADMIN_TOKEN=

# Production identity mode. Local bearer tokens are ignored in this mode.
# AUTH_MODE=oidc
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://lab.example/api/auth/callback
OIDC_SCOPES=openid profile email
OIDC_ROLE_CLAIM=roles
OIDC_GROUP_CLAIM=groups
OIDC_ORGANIZATION_CLAIM=organization
SESSION_SECRET=
PUBLIC_BASE_URL=https://lab.example
TRUST_PROXY=false

# Provider adapters. Keys remain server-side.
PRIMARY_PROVIDER=anthropic
PRIMARY_JUDGE_PROVIDER=anthropic
SECONDARY_PROVIDER=openai_compatible
ANTHROPIC_API_KEY=
ANTHROPIC_TARGET_MODEL=claude-sonnet-4-6
ANTHROPIC_JUDGE_MODEL=claude-sonnet-4-6
ANTHROPIC_EQUIVALENCE_MODEL=claude-sonnet-4-6
ANTHROPIC_SECONDARY_JUDGE_MODEL=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
SECONDARY_JUDGE_SAMPLE_RATE=0.10

# Optional harmless live trajectory dogfood. Uses the provider credentials above.
# DOGFOOD_PROVIDER=anthropic
# DOGFOOD_MODEL=claude-sonnet-4-6
# DOGFOOD_REPLICATIONS=5
# DOGFOOD_TEMPERATURE=0
# DOGFOOD_MAX_TOKENS=32
# DOGFOOD_OUTPUT=tmp/fil-dogfood-live.json

# Application signing identity and administrator-approved trust material.
SIGNING_PRIVATE_KEY_FILE=
SIGNING_CERTIFICATE_CHAIN_FILE=
TRUST_ANCHOR_FILES=
TRUST_CERTIFICATE_FILES=
REVOCATION_LIST_FILES=

# Local mode can retain JSON run compatibility. OIDC requires SQLite and
# authenticated encryption for sensitive records.
STORAGE_MODE=json
DATA_DIR=./data
DATABASE_PATH=./data/platform.sqlite
DATA_ENCRYPTION_KEY_ID=
DATA_ENCRYPTION_KEY=
# JSON object mapping old key IDs to base64 AES-256 keys during rotation.
DATA_DECRYPTION_KEYS=

# Legacy hash-only paths load as legacy_unknown and never grant v2 trust.
ENABLE_HOLDOUT=false
HOLDOUT_SCENARIO_PATH=
INDEPENDENT_REPLICATION_PATH=

# Separate sealed-holdout executor. Plaintext packs and keys live outside Git.
HOLDOUT_HOST=127.0.0.1
HOLDOUT_PORT=8790
HOLDOUT_ENCRYPTED_PACK_FILE=
HOLDOUT_DECRYPTION_KEY_ID=
HOLDOUT_DECRYPTION_KEY=
HOLDOUT_SIGNING_PRIVATE_KEY_FILE=
HOLDOUT_SIGNING_CERTIFICATE_CHAIN_FILE=
HOLDOUT_DATABASE_PATH=./data/holdout.sqlite
HOLDOUT_TARGET_PROVIDER=anthropic
HOLDOUT_JUDGE_PROVIDER=openai_compatible
HOLDOUT_MAX_CONCURRENCY=1

MAX_CONCURRENCY=4
