FROM node:22.19.0-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY tsconfig.server.json ./
COPY server ./server
RUN npx tsc -p tsconfig.server.json && npm prune --omit=dev

FROM node:22.19.0-bookworm-slim
ENV NODE_ENV=production HOLDOUT_HOST=0.0.0.0 HOLDOUT_PORT=8790
WORKDIR /app
RUN groupadd --system fil && useradd --system --gid fil --home /app fil && mkdir -p /app/data /app/secrets && chown -R fil:fil /app
COPY --from=build --chown=fil:fil /app/package.json /app/package-lock.json ./
COPY --from=build --chown=fil:fil /app/node_modules ./node_modules
COPY --from=build --chown=fil:fil /app/dist-server ./dist-server
USER fil
EXPOSE 8790
VOLUME ["/app/data", "/app/secrets"]
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 CMD ["node", "-e", "fetch('http://127.0.0.1:8790/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"]
STOPSIGNAL SIGTERM
CMD ["node", "dist-server/holdout/server.js"]
