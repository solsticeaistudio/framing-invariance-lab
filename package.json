{
  "name": "framing-invariance-lab",
  "private": true,
  "version": "2.2.6",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"tsx watch server/index.ts\"",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist-server/index.js",
    "test": "vitest run",
    "check": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "format": "prettier --write \"{server,src,scripts}/**/*.{ts,tsx}\" \"*.{md,json}\" \"docs/**/*.md\"",
    "format:check": "prettier --check \"{server,src,scripts}/**/*.{ts,tsx}\" \"*.{md,json}\" \"docs/**/*.md\"",
    "validate": "tsx scripts/validate-methodology.ts && tsx scripts/validate-reporting.ts",
    "scenarios:export": "tsx scripts/export-scenario-fixtures.ts",
    "study:verify-chain": "tsx scripts/verify-study-chain.ts",
    "fixture:archive": "tsx scripts/generate-verification-fixture.ts",
    "hash:replication-pack": "tsx scripts/hash-replication-pack.ts",
    "keys:generate": "tsx scripts/pki.ts generate",
    "cert:create-root": "tsx scripts/pki.ts create-root",
    "cert:issue": "tsx scripts/pki.ts issue",
    "cert:verify": "tsx scripts/pki.ts verify",
    "trust:add": "tsx scripts/pki.ts trust-add",
    "trust:list": "tsx scripts/pki.ts trust-list",
    "trust:revoke": "tsx scripts/pki.ts trust-revoke",
    "pack:hash": "tsx scripts/pack.ts hash",
    "pack:attest-independence": "tsx scripts/pack.ts attest-independence",
    "pack:sign": "tsx scripts/pack.ts sign",
    "pack:verify": "tsx scripts/pack.ts verify",
    "pack:seal": "tsx scripts/pack.ts seal",
    "pack:unseal": "tsx scripts/pack.ts unseal",
    "pack:inspect-metadata": "tsx scripts/pack.ts inspect-metadata",
    "artifacts:verify": "vitest run server/lib/canonicalJson.test.ts server/lib/signatures.test.ts server/lib/signedPacks.test.ts server/lib/archive.test.ts",
    "security:verify": "vitest run server/api-security.test.ts server/lib/authorization.test.ts server/lib/sessions.test.ts server/lib/publicDtos.test.ts server/lib/publicV2Dtos.test.ts",
    "audit:verify": "vitest run server/lib/audit.test.ts",
    "audit:verify-file": "tsx scripts/verify-audit.ts",
    "pdf:verify": "vitest run server/lib/pdf.test.ts",
    "pdf:verify-file": "tsx scripts/verify-pdf.ts",
    "archive:verify": "vitest run server/lib/archive.test.ts",
    "archive:verify-file": "tsx scripts/verify-archive.ts",
    "migration:verify": "vitest run server/lib/legacyMigration.test.ts server/lib/migration.test.ts",
    "migration:verify-files": "tsx scripts/verify-migration.ts",
    "migrate:v2": "tsx scripts/migrate-v2.ts",
    "rerun:plan": "tsx scripts/rerun-plan.ts",
    "holdout:serve": "tsx server/holdout/server.ts",
    "holdout:smoke": "vitest run server/holdout/protocol.test.ts server/holdout/index.test.ts",
    "oidc:smoke": "vitest run server/lib/oidc.test.ts server/lib/sessions.test.ts server/lib/authorization.test.ts",
    "fixture:verify": "vitest run server/lib/signatures.test.ts server/lib/signedPacks.test.ts server/lib/studyTier.test.ts server/holdout/protocol.test.ts server/lib/artifactService.test.ts server/lib/pdf.test.ts server/lib/archive.test.ts server/lib/publicV2Dtos.test.ts",
    "archive:test": "vitest run server/lib/archive.test.ts server/lib/pdf.test.ts",
    "lint": "npm run check && npm run format:check"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^5.1.0",
    "fflate": "^0.8.3",
    "jose": "^6.1.0",
    "openid-client": "^6.8.4",
    "pdf-lib": "^1.17.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "recharts": "^3.1.0",
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.3",
    "@types/node": "^24.1.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vite": "^7.0.6",
    "vitest": "^3.2.4"
  }
}
